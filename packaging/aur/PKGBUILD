# Maintainer: Websolutis <https://bernie.websolutis.com/suggest-an-idea/>
# Paquet AUR de Bernie, fait des .deb publiés sur https://github.com/beber666/bernie-releases (mis à jour par le
# workflow .github/workflows/aur.yml à chaque version).
pkgname=bernie-bin
pkgver=0.9.0
pkgrel=1
pkgdesc="Prepare and run laser engraving and cutting jobs (GRBL, grblHAL, FluidNC, Marlin, Smoothieware)"
arch=('x86_64' 'aarch64')
url="https://bernie.websolutis.com/"
license=('LicenseRef-Bernie')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
provides=('bernie')
conflicts=('bernie')
options=('!strip' '!debug')
source_x86_64=("https://github.com/beber666/bernie-releases/releases/download/v${pkgver}/Bernie_${pkgver}_amd64.deb")
source_aarch64=("https://github.com/beber666/bernie-releases/releases/download/v${pkgver}/Bernie_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" <<'LICENCE'
Bernie © 2026 Websolutis. Free to download and use; redistribution of the unchanged packages is allowed.
LICENCE
}
